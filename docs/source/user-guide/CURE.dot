digraph CURE {
    graph [rankdir=TB, splines=curved, nodesep=0.5, ranksep=0.45, fontname="Helvetica"]
    node  [fontname="Helvetica", fontsize=11, style=filled, fillcolor=white]
    edge  [color="#2255aa", arrowsize=0.8, fontsize=10, fontname="Helvetica"]

    // ---- terminal nodes ----
    node [shape=box, color="#22aa55", fontcolor="#22aa55", penwidth=2]
    cure_begin [label="CURE\nbegins"]
    cure_end   [label="CURE\nends"]

    // ---- decision diamonds ----
    node [shape=diamond, color="#2255aa", fontcolor=black, penwidth=1.5]
    conv    [label="Conversion\nreached?"]
    bonds   [label="Any bonds\nfound?"]
    above   [label="Above max\nradius?"]
    longer  [label="Any longer\nthan\nthreshold?"]

    // ---- process boxes ----
    node [shape=box, color="#2255aa", fontcolor=black, penwidth=1.5]
    init_r  [label="Initialize\nsearch radius"]
    ident   [label="Identify\nallowable bonds"]
    incr_r  [label="Increment\nsearch radius"]
    cap     [label="Cap unreacted\ngroups"]
    upd1    [label="Update\ntopology"]
    rel1    [label="Relax"]
    drag    [label="Drag"]
    upd2    [label="Update\ntopology"]
    rel2    [label="Relax"]
    equil   [label="Equilibrate"]

    // ---- layout: main column left, termination right ----
    { rank=same; cure_begin; conv }
    { rank=same; cap; init_r }
    { rank=same; above; ident }
    { rank=same; incr_r; bonds }
    { rank=same; longer }
    { rank=same; drag; upd2 }
    { rank=same; rel1; rel2 }

    // ---- main flow ----
    cure_begin -> conv
    conv   -> init_r  [label="n"]
    init_r -> ident
    ident  -> bonds
    bonds  -> above   [label="n"]
    above  -> incr_r  [label="y"]
    incr_r -> ident   [constraint=false]
    bonds  -> longer  [label="y"]
    longer -> drag    [label="y"]
    longer -> upd2    [label="n"]
    drag   -> upd2
    upd2   -> rel2
    rel2   -> equil
    equil  -> conv    [constraint=false]

    // ---- termination path ----
    conv   -> cap     [label="y"]
    above  -> cap     [label="n", constraint=false]
    cap    -> upd1
    upd1   -> rel1
    rel1   -> cure_end
}
